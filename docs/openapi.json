                  "estimatedHours"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Troca de óleo"
                  },
                  "description": {
                    "type": "string",
                    "example": "Troca completa com filtro"
                  },
                  "price": {
                    "type": "number",
                    "example": 80
                  },
                  "estimatedHours": {
                    "type": "number",
                    "example": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Serviço cadastrado com sucesso"
          },
          "400": {
            "description": "Dados inválidos"
          }
        }
      }
    },
