NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=oficina_db
DB_USER=postgres
DB_PASS=postgres123
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h
# Segredo injetado pelo API Gateway no header x-origin-verify. Vazio = verificação desabilitada (dev local)
ORIGIN_VERIFY_SECRET=
# Chave para rotas /internal/* (chamadas da Lambda de auth). Vazio = rotas internas desabilitadas
INTERNAL_API_KEY=
# Mensageria da Saga. Vazio = comandos ficam no outbox (sem publicar)
RABBITMQ_URL=amqp://oficina:oficina123@localhost:5672
# Email (opcional — se vazio, usa conta Ethereal automática para preview)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@oficina.com

# WhatsApp via Twilio (opcional — se vazio, canal desabilitado)
# Crie conta em twilio.com, ative o Sandbox em Messaging > Try it out > Send a WhatsApp message
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
